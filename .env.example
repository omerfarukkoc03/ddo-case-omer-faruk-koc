# Veritabanı (yalnız compose ağı içinden erişilir)
POSTGRES_DB=patiklinik
POSTGRES_USER=patiklinik
POSTGRES_PASSWORD=patiklinik_dev_password

# JWT imzalama anahtarı: en az 32 bayt. Üretimde mutlaka değiştirin.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Kliniğin saat dilimi: mesai saatleri ve "bugün" buna göre hesaplanır.
TZ_CLINIC=Europe/Istanbul
LOG_LEVEL=info

# Simülatör: aynı SEED → aynı veri. Canlı olay aralığı milisaniye.
SEED=42
SIM_ANIMALS=15000
SIM_OWNERS=10000
SIM_INTERVAL_MS=4000

# Aşı hatırlatma job'ının çalışma aralığı
REMINDER_JOB_INTERVAL=10m
